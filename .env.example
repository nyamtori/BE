# Copy this file to `.env` on the server and fill in real values.
# `.env` is gitignored — never commit it.

# MySQL
DB_USERNAME=nyamtori
DB_PASSWORD=change_me_strong_password
DB_ROOT_PASSWORD=change_me_root_password

# Auth
JWT_SECRET=change_me_long_random_string

# Kakao OAuth (Kakao Developers > 내 애플리케이션 > 앱 키 / 카카오 로그인)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# Gemini
GEMINI_API_KEY=

# Where the frontend should receive the OAuth callback redirect
FRONTEND_OAUTH_REDIRECT_URI=https://your-frontend-domain.com/oauth/callback
